FROM alpine:3.21 AS pick

ARG TARGETPLATFORM
COPY docker_context /tmp/artifacts
WORKDIR /tmp/output
RUN set -eux; \
    case "$TARGETPLATFORM" in \
      linux/amd64) ARCH=amd64 ;; \
      linux/arm64) ARCH=arm64 ;; \
      *) echo "Unsupported architecture: $TARGETPLATFORM"; exit 1 ;; \
    esac; \
    cp "/tmp/artifacts/orbien-server-linux-${ARCH}/orbien-server" .

FROM alpine:3.21

RUN apk add --no-cache ca-certificates tini
COPY --from=pick --chmod=755 /tmp/output/orbien-server /usr/local/bin/orbien-server
COPY docker/conf/orbien-server.toml /etc/orbien/orbien-server.toml
EXPOSE 9527/tcp 9527/udp 9528/udp 80/tcp 443/tcp 8020/tcp
ENTRYPOINT ["/sbin/tini", "--", "orbien-server"]
CMD ["-c", "/etc/orbien/orbien-server.toml"]
